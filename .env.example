# Local application configuration examples only.
# Copy to .env locally; never commit real credentials.

APP_ENV=development
APP_NAME=NIFTY Seller Intelligence
API_HOST=127.0.0.1
API_PORT=8000

# Configure after local PostgreSQL setup.
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database_name>

# Keep historical source files outside Git.
DATA_STORAGE_PATH=../local_data
