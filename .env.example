APP_ENV=development
APP_NAME=NIFTY Seller Intelligence
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database_name>

# Optional Backblaze B2 S3-compatible storage
B2_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
B2_REGION=<region>
B2_BUCKET_NAME=<bucket-name>
B2_APPLICATION_KEY_ID=<application-key-id>
B2_APPLICATION_KEY=<application-key>

# Extracted Phase 1 archive root (contains artifacts/manifests and artifacts/raw/nse)
DATA_STORAGE_PATH=../local_data
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
