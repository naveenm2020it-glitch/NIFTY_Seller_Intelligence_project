# Local application configuration examples only.
# Copy to .env locally; never commit real credentials.

APP_ENV=development
APP_NAME=NIFTY Seller Intelligence
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL connection.
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database_name>

# Backblaze B2 S3-compatible API. Create a bucket and a bucket-restricted
# application key in Backblaze. Never commit real credentials.
B2_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
B2_REGION=<region>
B2_BUCKET_NAME=<bucket-name>
B2_APPLICATION_KEY_ID=<application-key-id>
B2_APPLICATION_KEY=<application-key>

# Local working directory for future historical-data processing.
DATA_STORAGE_PATH=../local_data
